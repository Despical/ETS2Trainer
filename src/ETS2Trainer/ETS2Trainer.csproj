<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ETS2Trainer</AssemblyName>
    <RootNamespace>ETS2Trainer</RootNamespace>
    <Version>0.5.1</Version>
    <Authors>Despical</Authors>
    <Product>ETS2Trainer</Product>
    <Description>A portable Euro Truck Simulator 2 trainer for Windows with an in-game overlay and English/Turkish support.</Description>
    <Copyright>Copyright (C) 2026 Despical</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Despical/ETS2Trainer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Despical/ETS2Trainer</PackageProjectUrl>
    <ApplicationIcon>Assets\Trainer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Trainer.ico" />
    <EmbeddedResource Include="Localization\en.json" />
  </ItemGroup>
</Project>
